rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Must be signed in with a Google account (the app's only sign-in method).
    function signedIn() { return request.auth != null; }

    // Game / agent logs — append-only for players: create + read allowed, no edits.
    // Delete is reserved for the club's owner (GENERAL RESET) and the super admin;
    // regular players can never touch history.
    function superAdmin() {
      return signedIn() && request.auth.token.email == 'aaci.yoni@gmail.com';
    }
    function clubOwnerOf(cid) {
      return signedIn() && request.auth.uid == get(/databases/$(database)/documents/clubs/$(cid)).data.ownerUid;
    }
    match /gameLog/{id}   { allow read, create: if signedIn(); allow update: if false;
                            allow delete: if superAdmin() || clubOwnerOf(resource.data.clubId); }
    match /agentLog/{id}  { allow read, create: if signedIn(); allow update: if false;
                            allow delete: if superAdmin() || clubOwnerOf(resource.data.clubId); }

    // Core data — every access (read/write/delete) requires a signed-in account.
    // Fully blocks anonymous access from the internet without breaking any app action.
    // NOTE (roadmap): this is the safe baseline for the current client-side engine.
    // Field-level hardening (deny direct writes to balance/stack/cards/deck/rank, and
    // keep hole cards out of the shared doc) lands with the server-authoritative rework.
    match /users/{id}        { allow read, write: if signedIn(); }

    // Memberships hold player balances. The client engine needs open writes
    // (wins are paid from players' browsers) — no blocking here by owner's
    // choice: monitoring only, via the watchBalances Cloud Function, which
    // records every 500+ balance jump in securityAlerts. Real write-lockdown
    // arrives with the server-authoritative engine.
    match /memberships/{id}  { allow read, write: if signedIn(); }

    // Security alerts — written ONLY by Cloud Functions (admin SDK bypasses
    // these rules). The club owner / super admin can read and clear them;
    // players can't see they exist.
    match /securityAlerts/{id} {
      allow read, delete: if superAdmin() || clubOwnerOf(resource.data.clubId);
      allow create, update: if false;
    }

    match /tables/{id}       { allow read, write: if signedIn(); }

    // Server-engine private data: a player may read ONLY their own hole cards.
    // The deck/engine doc (_engine) and everyone else's cards are server-only.
    // No client ever writes here — only Cloud Functions (admin SDK bypasses rules).
    match /tables/{id}/priv/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Admin-only config (e.g. the GOD list) — no client access whatsoever.
    match /admin/{doc=**} { allow read, write: if false; }
    match /clubs/{id}        { allow read, write: if signedIn(); }
    match /tournaments/{id}  { allow read, write: if signedIn(); }
    match /broadcasts/{id}   { allow read, write: if signedIn(); }

    // ═══ Gadud 1895 — "ירוק בעיניים" daily ammo counter (ammo.html) ═══
    // Role model (all stored in ammo_config/main, editable by admins only):
    //   adminEmails  — full access: see all companies, edit quantities, manage roles.
    //   viewerEmails — view-only across ALL companies (מג"ד/סמג"ד/מפ"ם/ארמון): no writes.
    //   companyOf    — map of email-key (dots→commas) → company group ('a'/'b'/'d'/'bn'):
    //                  may count + report usage ONLY for their own company, sees only it.
    //   Anyone signed in but not listed anywhere gets NOTHING (default deny).
    // superAdmin() is checked first so everything bootstraps while the config doc
    // doesn't exist yet (get() on a missing doc errors → rule denies for others).
    function ammoCfg() {
      return get(/databases/$(database)/documents/ammo_config/main).data;
    }
    function ammoAdmin() {
      return superAdmin() ||
        (signedIn() && request.auth.token.email in ammoCfg().adminEmails);
    }
    function ammoViewer() {
      return signedIn() && request.auth.token.email in ammoCfg().viewerEmails;
    }
    // Firestore map keys can't contain '.', so emails are keyed with ',' instead.
    function ammoGroup() {
      return ammoCfg().companyOf[request.auth.token.email.replace('\\.', ',')];
    }
    function ammoCanSee(g)   { return ammoAdmin() || ammoViewer() || ammoGroup() == g; }
    function ammoCanCount(g) { return ammoAdmin() || ammoGroup() == g; }

    // Config must stay readable to any signed-in user so the client can learn
    // its own role; writes (roles + custom item lists) are admin-only.
    match /ammo_config/{doc} { allow read: if signedIn(); allow write: if ammoAdmin(); }

    // Baseline quantities per unit — ONLY admins may set/update quantities.
    // Docs carry a 'group' field so company members can read just their own.
    match /ammo_stock/{unit} {
      allow read: if ammoCanSee(resource.data.group);
      allow write: if ammoAdmin() &&
        request.resource.data.group == unit.split('_')[0];
    }

    // Usage reports — append-only for a company's own members (auto-adjusts the
    // expected count); viewers can read everything; edits/deletes are admin-only.
    match /ammo_usage/{id} {
      allow read: if ammoCanSee(resource.data.group);
      allow create: if ammoCanCount(request.resource.data.group) &&
        request.resource.data.group == request.resource.data.unitId.split('_')[0];
      allow update, delete: if ammoAdmin();
    }

    // Daily counts — a company member submits/resubmits only for their own
    // company; doc id is pinned to '<unitId>_<date>'; only admins delete.
    match /ammo_counts/{id} {
      allow read: if ammoCanSee(resource.data.group);
      allow create, update: if ammoCanCount(request.resource.data.group) &&
        request.resource.data.group == request.resource.data.unitId.split('_')[0] &&
        id == request.resource.data.unitId + '_' + request.resource.data.date;
      allow delete: if ammoAdmin();
    }

    // Anything not explicitly matched above — denied.
    match /{document=**}     { allow read, write: if false; }
  }
}
