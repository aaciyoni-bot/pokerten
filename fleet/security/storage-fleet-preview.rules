// Merge inside service firebase.storage / match /b/{bucket}/o only after reading current live rules.
// This addition is prepared, not yet published or verified.
match /fleet1894/preview/vehicles/{vehicleId}/{fileId} {
  function membership() { return firestore.get(/databases/(default)/documents/fleet1894/preview/members/$(request.auth.uid)).data; }
  function active() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'password' && membership().active == true && membership().loginEmail == request.auth.token.email; }
  function editor() { return active() && membership().role == 'officer'; }
  function reader() { return active() && membership().role in ['officer','viewer']; }
  allow read: if reader();
  allow create: if editor() && request.resource.size <= 30 * 1024 * 1024 && request.resource.contentType.matches('image/.*|video/.*|application/pdf');
  allow update, delete: if false;
}
