{
  "_comment": "Replace <SHA> with the same commit SHA used in build.js. The /__/auth and /__/firebase rewrites reverse-proxy Firebase's auth handler onto our own domain (fixes Chrome third-party storage partitioning). Icons are served same-origin from raw.githubusercontent at the pinned SHA.",
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://pokerten.firebaseapp.com/__/auth/:path*" },
    { "source": "/__/firebase/:path*", "destination": "https://pokerten.firebaseapp.com/__/firebase/:path*" },
    { "source": "/solo", "destination": "/solo.html" },
    { "source": "/icon-192.png", "destination": "https://raw.githubusercontent.com/aaciyoni-bot/pokerten/<SHA>/aviator-icon-192.png" },
    { "source": "/icon-512.png", "destination": "https://raw.githubusercontent.com/aaciyoni-bot/pokerten/<SHA>/aviator-icon-512.png" },
    { "source": "/maskable-512.png", "destination": "https://raw.githubusercontent.com/aaciyoni-bot/pokerten/<SHA>/aviator-maskable-512.png" }
  ]
}
