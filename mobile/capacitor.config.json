{
  "appId": "com.orizis.pokerten",
  "appName": "POKERTEN",
  "webDir": "www",
  "backgroundColor": "#06111c",
  "plugins": {
    "SystemBars": {
      "hidden": true,
      "style": "DARK"
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "updateUrl": "",
      "statsUrl": "",
      "channelUrl": "",
      "appReadyTimeout": 30000,
      "responseTimeout": 15,
      "autoDeleteFailed": false,
      "autoDeletePrevious": true,
      "resetWhenUpdate": true,
      "version": "0.352.1",
      "allowModifyUrl": false
    }
  },
  "server": {
    "hostname": "localhost",
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "contentInset": "automatic",
    "preferredContentMode": "mobile"
  }
}
