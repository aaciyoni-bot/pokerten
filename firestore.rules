rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Must be signed in. Two ways in: a Google account, or a guest (anonymous
    // auth) who gave a name and a number on the login screen and waits for the
    // club owner to approve them. Both land here as request.auth != null.
    function signedIn() { return request.auth != null; }

    // Game / agent logs — append-only for players: create + read allowed, no edits.
    // Delete is reserved for the club's owner (GENERAL RESET) and the super admin;
    // regular players can never touch history.
    function superAdmin() {
      return signedIn() && request.auth.token.email == 'aaci.yoni@gmail.com';
    }
    function clubOwnerOf(cid) {
      return signedIn() && request.auth.uid == get(/databases/$(database)/documents/clubs/$(cid)).data.ownerUid;
    }
    match /gameLog/{id}   { allow read, create: if signedIn(); allow update: if false;
                            allow delete: if superAdmin() || clubOwnerOf(resource.data.clubId); }
    match /agentLog/{id}  { allow read, create: if signedIn(); allow update: if false;
                            allow delete: if superAdmin() || clubOwnerOf(resource.data.clubId); }

    // Core data — every access (read/write/delete) requires a signed-in account.
    // Blocks unauthenticated access from the internet without breaking any app
    // action. NOTE: a guest account is authenticated, so it clears this bar the
    // same as a Google account does — approval by the club owner, not the rules,
    // is what gates a guest out of a club.
    // NOTE (roadmap): this is the safe baseline for the current client-side engine.
    // Field-level hardening (deny direct writes to balance/stack/cards/deck/rank, and
    // keep hole cards out of the shared doc) lands with the server-authoritative rework.
    match /users/{id}        { allow read, write: if signedIn(); }

    // Memberships hold player balances. The client engine needs open writes
    // (wins are paid from players' browsers) — no blocking here by owner's
    // choice: monitoring only, via the watchBalances Cloud Function, which
    // records every 500+ balance jump in securityAlerts. Real write-lockdown
    // arrives with the server-authoritative engine.
    match /memberships/{id}  { allow read, write: if signedIn(); }

    // Security alerts — written ONLY by Cloud Functions (admin SDK bypasses
    // these rules). The club owner / super admin can read and clear them;
    // players can't see they exist.
    match /securityAlerts/{id} {
      allow read, delete: if superAdmin() || clubOwnerOf(resource.data.clubId);
      allow create, update: if false;
    }

    match /tables/{id}       { allow read, write: if signedIn(); }

    // Server-engine private data: a player may read ONLY their own hole cards.
    // The deck/engine doc (_engine) and everyone else's cards are server-only.
    // No client ever writes here — only Cloud Functions (admin SDK bypasses rules).
    match /tables/{id}/priv/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Admin-only config (e.g. the GOD list) — no client access whatsoever.
    match /admin/{doc=**} { allow read, write: if false; }
    match /clubs/{id}        { allow read, write: if signedIn(); }
    match /tournaments/{id}  { allow read, write: if signedIn(); }
    match /broadcasts/{id}   { allow read, write: if signedIn(); }

    // Anything not explicitly matched above — denied.
    match /{document=**}     { allow read, write: if false; }
  }
}
